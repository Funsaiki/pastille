{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pastille",
  "mainBinaryName": "pastille",
  "version": "1.10.2",
  "identifier": "dev.lanceur.pastel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Pastille",
        "width": 1440,
        "height": 900,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0MDQxNjA5OTRBNkRCMEMKUldRTTI2YVVDUllFQkEreEtvTVVLOXFnNXJ2QXBJd2hqbGZtMDFrdnEzR1hoM0FDZ1RpVlJtaEQK",
      "endpoints": ["https://github.com/Funsaiki/pastille/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "shortDescription": "Lanceur d'applications en forme de téléphone pastel",
    "windows": {
      "nsis": { "languages": ["French"], "installMode": "currentUser" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
